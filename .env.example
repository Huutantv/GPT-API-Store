ANTHROPIC_AUTH_TOKEN=sk-...
ANTHROPIC_BASE_URL=https://api.vietapi.tech/v1

DORO_BACKEND_MODEL=claude-opus-4.6
DORO_PROXY_KEYS=sk-CHANGE-ME-48CHARS-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SECURITY: must be 32+ random chars. NEVER commit real value. Generate: openssl rand -hex 32
DORO_ADMIN_KEY=CHANGE-ME-32RANDOMCHARS-min
# SECURITY: comma-separated admin IPs allowed to call /api/* admin. Empty = allow all.
# WARNING: set your own public IP first (curl ifconfig.me), keep localhost auto-allowed.
# Example: DORO_ADMIN_IP_WHITELIST=1.2.3.4,5.6.7.8
DORO_ADMIN_IP_WHITELIST=
# SECURITY: use random unguessable paths, different per deploy. Example: /admin-a3f9c2e1b7 , /dash-7b2e9f1c4a
DORO_DASHBOARD_PATH=/dashboard-CHANGE-ME-RANDOM
DORO_ADMIN_PATH=/admin-CHANGE-ME-RANDOM
DORO_PUBLIC_URL=https://example.com

BANK_ACCOUNT=CHANGE-ME
BANK_CODE=CHANGE-ME
BANK_OWNER=CHANGE-ME
BANK_NAME=CHANGE-ME

MAIL_USER=your@gmail.com
MAIL_PASS=your-app-password

SEPAY_WEBHOOK_SECRET=CHANGE-ME-32RANDOMCHARS-min
# Webhook Casso (header secure-token). BẮT BUỘC đặt — thiếu là webhook trả 503.
CASSO_WEBHOOK_SECRET=CHANGE-ME-32RANDOMCHARS-min

TELEGRAM_BOT_TOKEN=CHANGE-ME
TELEGRAM_CHAT_ID=CHANGE-ME

DORO_BACKEND1_WEIGHT=80
DORO_BACKEND2_WEIGHT=20
DORO_BACKEND1_USER_ASSISTANT_ONLY=0
DORO_BACKEND1_DISABLE_TOOLS=0
DORO_BACKEND2_USER_ASSISTANT_ONLY=0
DORO_BACKEND2_DISABLE_TOOLS=0

# Backend 5 context (Zunef/native Anthropic)
DORO_BACKEND5_BASE_URL=https://backend5.example/v1
DORO_BACKEND5_AUTH_TOKEN=sk-...
DORO_BACKEND5_MODEL=gpt-5.4
DORO_BACKEND5_API_STYLE=anthropic

# Backend 5 Vision (OpenAI-compatible by default)
DORO_BACKEND5_VISION_BASE_URL=https://vision.example/v1
DORO_BACKEND5_VISION_AUTH_TOKEN=sk-...
DORO_BACKEND5_VISION_MODEL=gpt-4o
DORO_BACKEND5_VISION_API_STYLE=openai

DORO_PROXY_PORT=4000
# Keep JSON/base64 uploads bounded to protect the Node heap.
DORO_BODY_LIMIT=50mb
# Limit concurrent upstream requests and queued/large request memory per Node process.
DORO_MAX_CONCURRENT=10
DORO_MAX_BACKEND_QUEUE=10
DORO_MAX_INFLIGHT_REQUESTS=20
DORO_MAX_INFLIGHT_BODY_BYTES=67108864

# Backend 2 (dự phòng)
DORO_BACKEND2_BASE_URL=https://hk.doro.lol/v1
DORO_BACKEND2_AUTH_TOKEN=sk-...
DORO_BACKEND2_MODEL=gpt-5.4-mini
DORO_BACKEND2_USER_ASSISTANT_ONLY=0
DORO_BACKEND2_DISABLE_TOOLS=0





# Router
DORO_QUOTA_KEY=sk-...

# Bat ca 5 backend text. Backend 5 context duoc uu tien, sau do failover qua 1-4.
# Backend 5 Vision (5v) la nhanh rieng va tu dong duoc chon khi user gui anh moi.
DORO_ACTIVE_BACKEND=all
DORO_BACKEND_ROUTER_MODE=failover
DORO_AUTO_MODE=0
DORO_AUTO_ERROR_THRESHOLD=3
DORO_AUTO_RECOVERY_MS=120000
DORO_AUTO_SOFT_RECOVERY_SUCCESS=2
DORO_AUTO_SOFT_RECOVERY_WINDOW_MS=30000

DORO_MODEL_FALLBACK=gpt-5.5,gpt-5.5-high,gpt-5.5-xhigh,gpt-5.4,gpt-5.3-codex
DORO_MODEL_DAILY_LIMIT=1800

DORO_MODEL_LIMITS=gpt-5.5:2000,gpt-5.5-high:2000,gpt-5.5-xhigh:2000,claude-opus-4.6:200,claude-opus-4.7:200

DORO_TOKEN_PER_REQUEST=100000

TELEGRAM_ALERTS_ENABLED=1
DORO_BACKEND_REQUEST_RETRIES=5
DORO_BACKEND_STREAM_RETRIES=3
# TTFB failover: bỏ backend treo sau X ms (mặc định 15000), không chờ hết DORO_BACKEND_TIMEOUT
DORO_BACKEND_TTFB_TIMEOUT_MS=15000
# Route backend nhanh nhất trước ở chế độ failover (dựa trên EWMA latency). 0 = tắt.
DORO_LATENCY_ROUTING=1
# Upstream keep-alive (tái dùng TLS connection tới backend, giảm 100-300ms/req)
DORO_UPSTREAM_KEEPALIVE=1
DORO_UPSTREAM_CONNECTIONS=100
DORO_UPSTREAM_KEEPALIVE_MS=30000
# Cache owner lookup (chỉ dùng cho log hiển thị) — tăng để giảm query SQLite
DORO_REQUEST_OWNER_CACHE_TTL_MS=300000
DORO_SAFE_STREAM_FAILOVER=1
DORO_SAFE_STREAM_MAX_BYTES=8388608
# Ep stream cho path non-stream: gui stream:true len backend roi gop chunk thanh JSON.
# Giup on dinh/lien tuc (tranh 504/502 do upstream idle timeout khi phan hoi dai).
# 0 = tat (dung path non-stream cu) | 1 = bat (ep stream). Mac dinh tat de rollback de.
DORO_FORCE_STREAM_NONSTREAM=0
DORO_RETRY_BASE_DELAY_MS=1000
DORO_RETRY_MAX_DELAY_MS=15000
DORO_RETRY_JITTER_MS=1000

DORO_BACKEND1_MAX_TOKENS=16384
DORO_BACKEND2_MAX_TOKENS=16384
DORO_CODEX_MAX_OUTPUT_TOKENS=32768

# Server-side AI tools (read-only allowlist for public API users)
DORO_SERVER_TOOLS_ENABLED=true
DORO_SERVER_TOOLS_MAX_ROUNDS=10

# IP Guard (chống DDoS / lạm dụng)
DORO_IPGUARD_ENABLED=true
DORO_IPGUARD_RPS_LIMIT=20
DORO_IPGUARD_RPM_LIMIT=400
DORO_IPGUARD_UNAUTH_LIMIT=30
DORO_IPGUARD_ERR4XX_LIMIT=60
DORO_IPGUARD_AUTO_BAN_MINUTES=60
# Chống share key: 1 IP dùng quá số key phân biệt trong window (giây) → auto-ban.
# Mặc định 1 = key thứ 2 là ban. Đặt MAX_KEYS=0 để tắt.
DORO_IPGUARD_MULTIKEY_ENABLED=true
DORO_IPGUARD_MAX_KEYS_PER_IP=1
DORO_IPGUARD_KEY_WINDOW_SEC=300
# Chiều ngược: 1 key xuất hiện trên quá số IP trong window → ban CẢ IP cũ lẫn mới.
# Mặc định 1 = IP thứ 2 là ban cả 2. Đặt MAX_IPS=0 để tắt.
DORO_IPGUARD_KEYSHARE_ENABLED=true
DORO_IPGUARD_MAX_IPS_PER_KEY=1
DORO_IPGUARD_KEY_IP_WINDOW_SEC=300
# Hành động khi share key: ban_ip (ban cả 2 IP) | disable_key (khóa key) | both
DORO_KEYSHARE_ACTION=ban_ip
DORO_IPGUARD_WHITELIST=127.0.0.1,::1,::ffff:127.0.0.1
DORO_IPGUARD_TRUST_CF=true

# Key Health (per-backend-key optimization)
DORO_KEY_SICK_MINUTES=10
DORO_KEY_COOLDOWN_SECONDS=60

# Response Cache (giảm token backend cho request lặp - agent loop/codex/claude code)
# Cache response theo hash(model+messages+params). Hit => 0 token backend, không trừ credit.
# Bỏ qua request có ảnh, n>1, retry/failover, error.
DORO_RESPONSE_CACHE=0
DORO_CACHE_STREAM=1
DORO_CACHE_TTL_MS=600000
DORO_CACHE_MAX_ENTRIES=1000
DORO_CACHE_MAX_BODY_BYTES=2097152

# Input token optimization (tiết kiệm token backend, không ảnh hưởng chất lượng)
# Strip thinking blocks khỏi assistant messages cũ trong history (auto cho deepseek/minimax).
# Bỏ đi: 1=luôn bật, 0=luôn tắt, không set=auto theo model.
DORO_STRIP_THINKING_INPUT=
# Truncate history khi quá dài (giữ system + N cuối, bảo toàn tool pairs).
# Mặc định OFF. Chỉ bật khi agent loop gửi conversation cực dài.
DORO_TRUNCATE_HISTORY=0
DORO_TRUNCATE_HISTORY_MAX=80
DORO_TRUNCATE_HISTORY_KEEP=40

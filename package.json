{
  "name": "doro-proxy",
  "version": "2.2.2",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node doro_proxy_node.js",
    "check": "node --check doro_proxy_node.js",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"node doro_proxy_node.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.19.2",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.35",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2"
  }
}
